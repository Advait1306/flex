# Required
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# LLM Provider — pick one:
# OpenAI (default)
PROVIDER=OpenAI
LLM=openai/gpt-5-mini
# Cerebras (realtime pipeline speed)
PROVIDER=cerebras
LLM=openai/gpt-oss-120b

# Optional (defaults shown)
EMBEDDING_MODEL=openai/text-embedding-3-small
DATABASE_URL=postgres://flex:flex@localhost:5433/flex
QDRANT_URL=http://localhost:6333
CORS_ORIGINS=http://localhost:3000

# LangSmith (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Flex-Dev
